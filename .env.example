# chat2api configuration — copy to `.env` and edit. All vars use the CHAT2API_ prefix.

# ---- HTTP server ----
CHAT2API_HOST=0.0.0.0
CHAT2API_PORT=9000
CHAT2API_LOG_LEVEL=info
# Comma-separated bearer keys clients must send. Leave empty to disable auth.
CHAT2API_API_KEYS=

# ---- Provider ----
# One of: expressai | perplexity | googleaimode
# googleaimode needs no login; expressai/perplexity require a browser session.

# ---- MCP (optional) ----
# JSON file describing MCP servers whose tools are advertised to the model.
# Defaults to mcp.json in the CWD (auto-loaded if present); override the path here.
# CHAT2API_MCP_CONFIG_PATH=mcp.json

# ---- Responses API (optional) ----
# Expose the stateful /v1/responses endpoint (agentic loop + server-side MCP).
# CHAT2API_ENABLE_RESPONSES=true
# Max model<->tool round-trips within a single /v1/responses request.
# CHAT2API_MAX_AGENT_TURNS=6

# ---- Browser ----
# Set to false for the first run so you can log in manually; the login is saved.
CHAT2API_HEADLESS=true
CHAT2API_USER_DATA_DIR=.browser_profile
# Alternative to USER_DATA_DIR: path to a Playwright storage_state JSON export.
# CHAT2API_STORAGE_STATE=auth.json
CHAT2API_MAX_CONCURRENCY=2
# Recycle a tab after this many uses (0 = never). Tabs always recycle on error.
CHAT2API_MAX_TAB_USES=200
CHAT2API_NAV_TIMEOUT_MS=45000

# ---- Unattended re-authentication (optional) ----
# Drive a provider's sign-in form when its session expires, instead of needing a
# human at the noVNC session. ExpressAI's session lasts 24h. See docs/auto-login.md
# — in particular, point OTP_SOURCE at a DEDICATED mailbox: the token reads the
# whole account, and the label below only narrows our query, not the token.
# CHAT2API_AUTO_LOGIN=true
# CHAT2API_OTP_SOURCE=gmail
# Mint these once with: python scripts/gmail_oauth.py --client-id ... --client-secret ...
# CHAT2API_GMAIL_CLIENT_ID=
# CHAT2API_GMAIL_CLIENT_SECRET=
# CHAT2API_GMAIL_REFRESH_TOKEN=
# Optional mailbox label to narrow to further. Only set this if you actually
# created the label — the provider already filters by its own sender.
# CHAT2API_GMAIL_OTP_LABEL=
# Fallback code regex, used only by a provider that declares none of its own.
# The sender and pattern for each provider live in its LoginFlow (see
# src/providers/expressai.py) — override per provider below if a site changes.
# CHAT2API_OTP_CODE_PATTERN=(?i)code\D{0,20}(\d{4,8})
# CHAT2API_OTP_WAIT_TIMEOUT_S=120
# How long to refuse retries after a failed login (each attempt spends a code).
# CHAT2API_LOGIN_RETRY_COOLDOWN_S=900

# ---- Provider base URLs ----
CHAT2API_EXPRESSAI_BASE_URL=https://app.expressai.com
# Account email for auto-login (only used when CHAT2API_AUTO_LOGIN=true).
# ExpressVPN's sign-in is passwordless — email, then an emailed code — so no
# password is needed. The setting below exists only for its alternative
# "Sign in with your password" route, which the LoginFlow does not take.
# CHAT2API_EXPRESSAI_EMAIL=
# CHAT2API_EXPRESSAI_PASSWORD=
# The code mail's sender/format are declared in src/providers/expressai.py.
# These only exist to override them without a redeploy.
# CHAT2API_EXPRESSAI_OTP_FROM=
# CHAT2API_EXPRESSAI_OTP_PATTERN=
CHAT2API_PERPLEXITY_BASE_URL=https://www.perplexity.ai
CHAT2API_RESPONSE_TIMEOUT_S=180
CHAT2API_POLL_INTERVAL_S=0.2
